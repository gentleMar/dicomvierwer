# 应用配置
APP_NAME=DICOM Viewer
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FETCH_MODE=memory
TESSERACT_CMD=path/to/tesseract

# 图像渲染缓存（切换多帧时减少重复解码）
RENDER_CACHE_MAX_BYTES=209715200
RENDER_CACHE_MAX_ITEMS=128
RENDER_CACHE_TTL_SECONDS=1800
DATASET_CACHE_MAX_ITEMS=8
DATASET_CACHE_TTL_SECONDS=1800
ANALYSIS_MAX_REGIONS=20

# 本机读取目录（disk模式同步数据目录）
LOCAL_SYNC_DIR=./example-synced-dir

# 远端 DICOM 源（仅供同步脚本使用）
REMOTE_HOST=example.com
REMOTE_USER=exampleuser
REMOTE_PORT=22
REMOTE_DICOM_DIR=path/to/remote/dicomroot

# 服务配置
HOST=127.0.0.1
PORT=8000
RELOAD=true

# 用户配置（默认用户，可选）
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin123
